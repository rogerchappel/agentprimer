{
  "name": "agentprimer",
  "version": "0.1.0",
  "description": "Local-first repo onboarding packet CLI for coding agents.",
  "type": "module",
  "bin": {
    "agentprimer": "./dist/src/cli-entry.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && node dist/src/cli-entry.js scan fixtures/node-cli --out /tmp/agentprimer-smoke.md && node dist/src/cli-entry.js suggest-task fixtures/sparse-repo --max-risk low",
    "package:smoke": "npm run build && node scripts/verify-package-bin.mjs",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke",
    "prepack": "npm run build",
    "lint": "npm run check"
  },
  "keywords": [
    "agent",
    "cli",
    "onboarding",
    "repository",
    "handoff"
  ],
  "homepage": "https://github.com/rogerchappel/agentprimer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/agentprimer.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/agentprimer/issues"
  },
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
